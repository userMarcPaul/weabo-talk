<div class="flex items-start justify-between mb-4">
  <div class="flex items-center gap-3">
    <%= render Profiles::ImageComponent.new(user: post.user, size: "md") %>

    <div>
      <p class="font-semibold text-slate-100">
        <%= link_to username, user_profile_path, class: "hover:text-purple-400 transition" %>
      </p>
      <p class="text-xs text-slate-400">
        <%= time_since_creation %> ago
        <% if is_edited? %>
          (edited)
        <% end %>
      </p>
    </div>
  </div>

  <% if is_post_owner? %>
    <%# Click to open (hover doesn't exist on phones); closes on outside click or Escape %>
    <details class="relative" data-controller="dropdown">
      <summary class="list-none cursor-pointer p-2 hover:bg-slate-700/50 rounded-lg transition" aria-label="Post options">
        <svg class="w-5 h-5 text-slate-400" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
          <circle cx="10" cy="4" r="1.75" />
          <circle cx="10" cy="10" r="1.75" />
          <circle cx="10" cy="16" r="1.75" />
        </svg>
      </summary>

      <div class="absolute right-0 mt-2 w-48 bg-slate-900 border border-slate-700/50 rounded-lg shadow-xl py-2 z-20">
        <%= link_to "Edit Post", edit_post_path(post), class: "block w-full text-left px-4 py-2 text-sm text-slate-300 hover:bg-slate-800/50 transition" %>
        <%= button_to "Delete Post", post_path(post), method: :delete, data: { turbo_confirm: "Delete this post?", confirm_details: "Its comments, likes and reactions will be deleted too. This can't be undone.", confirm_button: "Delete", turbo_stream: true }, class: "block w-full text-left px-4 py-2 text-sm text-rose-400 hover:bg-rose-900/30 transition bg-transparent border-0 cursor-pointer" %>
      </div>
    </details>
  <% end %>
</div>

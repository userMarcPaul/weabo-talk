<div class="min-h-screen bg-slate-950 text-white">
  <div class="container mx-auto px-4 py-8 max-w-3xl">
    <!-- Header -->
    <div class="mb-8">
      <h1 class="text-3xl sm:text-4xl font-bold mb-2">
        <span class="bg-linear-to-r from-purple-400 to-pink-400 bg-clip-text text-transparent">Messages</span>
      </h1>
      <p class="text-slate-400">Chat privately with other anime fans</p>
    </div>

    <!-- Under Construction -->
    <div role="status" class="bg-amber-950/40 border border-amber-500/40 rounded-xl p-6 sm:p-8 flex flex-col sm:flex-row items-center sm:items-start gap-5 text-center sm:text-left">
      <div class="shrink-0 w-14 h-14 rounded-full bg-amber-500/15 border border-amber-500/30 flex items-center justify-center">
        <svg class="w-7 h-7 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v3.75m0 3.75h.008M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z" />
        </svg>
      </div>
      <div class="flex-1 min-w-0">
        <span class="inline-block px-3 py-1 mb-3 text-xs font-bold uppercase tracking-wide text-amber-300 bg-amber-500/20 border border-amber-500/30 rounded-full">Under construction</span>
        <h2 class="text-xl font-bold text-amber-100 mb-2">Messages aren't available yet</h2>
        <p class="text-amber-100/70 leading-relaxed">We're still building direct messages. Until then, you can follow other fans and talk in the comments of their posts.</p>
        <div class="mt-6 flex flex-col sm:flex-row gap-3 justify-center sm:justify-start">
          <%= link_to "Back to Feed", home_path, class: "px-5 py-2 bg-purple-600 hover:bg-purple-700 text-white rounded-lg font-semibold text-sm transition" %>
          <%= link_to "Find Users", search_users_path, class: "px-5 py-2 bg-slate-700/60 hover:bg-slate-700 text-slate-200 rounded-lg font-semibold text-sm transition" %>
        </div>
      </div>
    </div>
  </div>
</div>

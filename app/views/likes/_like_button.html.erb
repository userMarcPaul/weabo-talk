<%# Uses the loaded likes, so the feed doesn't query per post %>
<% like = current_user && post.likes.find { |l| l.user_id == current_user.id } %>
<div id="<%= dom_id(post, :like) %>">
<% if user_signed_in? %>
  <% if like %>
    <%= button_to "❤️ Unlike", 
      post_like_path(post, like), 
      method: :delete,
      data: { turbo_stream: true },
      class: "flex-1 py-2 text-center rounded-lg hover:bg-rose-900/30 text-rose-400 transition font-semibold text-sm bg-transparent border-0 cursor-pointer" %>
  <% else %>
    <%= button_to "🤍 Like", 
    post_likes_path(post), 
    method: :post, 
    data: { turbo_stream: true},
    class: "flex-1 py-2 text-center rounded-lg hover:bg-slate-700/50 text-slate-300 transition font-semibold text-sm bg-transparent border-0 cursor-pointer" %>
  <% end %>
<% else %>
  <%= link_to "🤍 Like", user_session_path, data: { turbo_frame: "_top" }, class: "flex-1 py-2 text-center rounded-lg hover:bg-slate-700/50 text-slate-300 transition font-semibold text-sm" %>
<% end %>
</div>

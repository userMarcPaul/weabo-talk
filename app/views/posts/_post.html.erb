<div id="<%= dom_id(post) %>" class="bg-slate-800/50 backdrop-blur-md border border-slate-700/50 rounded-xl p-6 mb-6 shadow-lg hover:shadow-xl transition">
  <%= render Posts::HeaderComponent.new(post: post, current_user: current_user) %>
  <div class="mb-4">
    <% if post.title.present? %>
      <h3 class="text-xl font-bold text-slate-100 mb-2 break-words">
        <%= link_to post.title, post_path(post), class: "hover:text-purple-400 transition" %>
      </h3>
    <% end %>
    <%= link_to post_path(post) do%>
    <%# Content on one line: whitespace-pre-wrap would show the template's indentation %>
    <p class="text-slate-300 leading-relaxed whitespace-pre-wrap break-words"><%= post.content %></p>
    <% end %>
  </div>

  <%= render "posts/images", images: post.post_images %>

  <!-- Post Stats -->
   <turbo-frame id="<%= dom_id(post, :actions) %>"> 
  <%= render "posts/stats", post: post %>

  <!-- Like, Reaction, Comment Buttons -->
  
 
    <div class="flex gap-2">
    <%# The partials carry the ids (like_post_1, reaction_post_1) their turbo streams replace %>
    <%= render "likes/like_button", post: post %>
    <%= render "reactions/reaction_button", post: post %>
     
    <%= link_to "💬 Comment", post_path(post), data: { turbo_frame: "_top" }, class: "flex-1 py-2 text-center rounded-lg hover:bg-slate-700/50 text-slate-300 transition font-semibold text-sm" %> 
      
    </div>
  </turbo-frame>

</div>

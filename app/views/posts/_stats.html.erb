<%# Like, reaction and comment counts. The likes, reactions and comments turbo streams
    replace this after each change, so the counts update without reloading the page. %>
<div id="<%= dom_id(post, :stats) %>" class="relative flex flex-wrap gap-x-4 gap-y-1 text-sm text-slate-400 mb-4 py-3 border-y border-slate-700/30">
  <span><strong class="text-slate-200"><%= post.likes.size %></strong> likes</span>
  <% if post.reactions.size.zero? %>
    <span><strong class="text-slate-200">0</strong> reactions</span>
  <% else %>
    <%# Click the total to open the reactions card. Its list loads when the card opens
        (lazy frame inside a closed <details>), so the feed doesn't load every reactor. %>
    <%# Phones: the card spans the counts row; wider screens: under "N reactions" %>
    <details class="sm:relative" data-controller="dropdown">
      <summary class="cursor-pointer list-none hover:text-purple-300 transition">
        <strong class="text-slate-200"><%= post.reactions.size %></strong> reactions
      </summary>
      <div class="absolute left-0 right-0 sm:right-auto top-full mt-2 sm:w-64 bg-slate-900/95 backdrop-blur-md border border-slate-700/50 rounded-lg shadow-xl p-4 z-40">
        <h4 class="text-xs font-semibold uppercase tracking-wide text-slate-500 mb-3">Reactions</h4>
        <%= turbo_frame_tag "reactions_card_#{dom_id(post)}", src: post_reactions_path(post), loading: :lazy do %>
          <p class="text-slate-400">Loading…</p>
        <% end %>
      </div>
    </details>
  <% end %>
  <span><strong class="text-slate-200"><%= post.comments.size %></strong> comments</span>
</div>

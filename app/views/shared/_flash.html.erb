<%# Flash messages, rendered once by the application layout %>
<% if notice.present? %>
  <div class="fixed top-20 left-1/2 -translate-x-1/2 w-96 max-w-[calc(100vw-2rem)] bg-emerald-900/80 border border-emerald-500/50 p-4 rounded-lg shadow-xl backdrop-blur-md z-50">
    <div class="flex items-start">
      <svg class="w-6 h-6 text-emerald-400 mt-0.5 mr-3 shrink-0" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
      </svg>
      <p class="text-emerald-100 font-semibold text-sm"><%= notice %></p>
    </div>
  </div>
<% end %>

<% if alert.present? %>
  <div class="fixed top-20 left-1/2 -translate-x-1/2 w-96 max-w-[calc(100vw-2rem)] bg-rose-900/80 border border-rose-500/50 p-4 rounded-lg shadow-xl backdrop-blur-md z-50">
    <div class="flex items-start">
      <svg class="w-6 h-6 text-rose-400 mt-0.5 mr-3 shrink-0" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
      </svg>
      <p class="text-rose-100 font-semibold text-sm"><%= alert %></p>
    </div>
  </div>
<% end %>

<!-- Navigation Bar -->
<nav class="bg-slate-950/80 backdrop-blur-lg sticky top-0 z-50 shadow-lg">
  <%# Wraps on phones: the search box moves to its own full-width row %>
  <div class="container mx-auto px-4 py-3 flex flex-wrap md:flex-nowrap items-center justify-between gap-x-4 gap-y-2">
    <!-- Logo -->
    <div class="flex items-center space-x-2">
      <%= link_to root_path, class: "flex items-center space-x-2 hover:opacity-80 transition" do %>
        <div class="text-2xl font-bold bg-linear-to-r from-purple-400 to-pink-400 bg-clip-text text-transparent">WT</div>
        <span class="hidden sm:inline text-lg font-bold text-transparent bg-clip-text bg-linear-to-r from-purple-300 via-pink-300 to-indigo-300">WeaboTalk</span>
      <% end %>
    </div>

    <!-- Search Box (visible when signed in): rendered once, second row on phones -->
    <% if user_signed_in? %>
      <div class="order-last w-full md:order-none md:w-auto md:flex-1 md:max-w-lg flex">
        <%= render "users/search_box" %>
      </div>
    <% end %>

    <!-- Navigation Links & User Menu -->
    <div class="flex items-center gap-2 lg:gap-4">
      <% if user_signed_in? %>
        <% username = current_user.profile&.username %>

        <!-- Quick Links (wide screens; smaller screens have them in the profile menu) -->
        <div class="hidden lg:flex items-center space-x-3">
          <%= link_to "Feed", home_path, class: "px-3 py-2 text-slate-300 hover:text-purple-400 transition font-semibold text-sm whitespace-nowrap" %>
          <% if username %>
            <%= link_to "Following", profile_following_path(username), class: "px-3 py-2 text-slate-300 hover:text-purple-400 transition font-semibold text-sm whitespace-nowrap" %>
            <%= link_to "Followers", profile_followers_path(username), class: "px-3 py-2 text-slate-300 hover:text-purple-400 transition font-semibold text-sm whitespace-nowrap" %>
          <% end %>
        </div>

        <%# Notifications stay visible at every size: the live badge has one id (broadcast target) %>
        <%= link_to notifications_path, class: "flex items-center px-3 py-2 text-slate-300 hover:text-purple-400 transition font-semibold text-sm relative whitespace-nowrap", title: "Notifications" do %>
          <svg class="lg:hidden w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
          </svg>
          <span class="hidden lg:inline">Notifications</span>
          <span class="sr-only lg:hidden">Notifications</span>
          <%= render "notifications/badge", user: current_user %>
        <% end %>
        <%# Real-time notifications (see Notification#broadcast_to_recipient) %>
        <%= turbo_stream_from current_user, :notifications %>

        <!-- Profile Menu (every screen size; opens on click so it works on touch screens) -->
        <details class="relative" data-controller="dropdown">
          <summary class="list-none cursor-pointer flex items-center space-x-2 px-3 py-2 rounded-lg hover:bg-slate-800/50 transition duration-200 text-slate-300 relative" aria-label="Profile menu">
            <div class="hidden xl:block text-right">
              <p class="text-sm font-semibold text-slate-100 truncate max-w-48"><%= current_user.email %></p>
              <p class="text-xs text-slate-400">User</p>
            </div>
            <svg class="w-6 h-6 text-purple-400" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd" />
            </svg>
          </summary>

          <%# Solid background (backdrop-blur doesn't work inside the navbar's own backdrop-blur);
              z-50 keeps it above the search box (z-40) %>
          <div class="absolute right-0 z-50 mt-2 w-60 max-w-[calc(100vw-2rem)] bg-slate-900 border border-slate-700/50 rounded-lg shadow-xl py-2">
            <!-- User Info -->
            <div class="px-4 py-2 border-b border-slate-700/30">
              <p class="text-sm font-semibold text-slate-100 truncate"><%= current_user.email %></p>
              <p class="text-xs text-slate-400 mt-1">Signed in</p>
            </div>

            <!-- Navigation (in the bar on wide screens) -->
            <div class="lg:hidden px-2 py-2 border-b border-slate-700/30">
              <%= link_to "Feed", home_path, class: "block w-full text-left px-4 py-2 text-sm text-slate-300 hover:bg-slate-800/50 rounded transition" %>
              <% if username %>
                <%= link_to "Following", profile_following_path(username), class: "block w-full text-left px-4 py-2 text-sm text-slate-300 hover:bg-slate-800/50 rounded transition" %>
                <%= link_to "Followers", profile_followers_path(username), class: "block w-full text-left px-4 py-2 text-sm text-slate-300 hover:bg-slate-800/50 rounded transition" %>
              <% end %>
            </div>

            <!-- Profile & Settings Links -->
            <div class="px-2 py-2">
              <% if current_user.profile %>
                <%= link_to "View Profile", profile_path(current_user.profile.username), class: "block w-full text-left px-4 py-2 text-sm text-slate-300 hover:bg-slate-800/50 rounded transition" %>
                <%= link_to "Edit Profile", edit_profile_path(current_user.profile.username), class: "block w-full text-left px-4 py-2 text-sm text-slate-300 hover:bg-slate-800/50 rounded transition" %>
                <%= link_to "My Posts", profile_path(current_user.profile.username), class: "block w-full text-left px-4 py-2 text-sm text-slate-300 hover:bg-slate-800/50 rounded transition" %>
                <%= link_to "My Drafts", drafts_posts_path, class: "block w-full text-left px-4 py-2 text-sm text-slate-300 hover:bg-slate-800/50 rounded transition" %>
              <% else %>
                <p class="block w-full text-left px-4 py-2 text-sm text-slate-500">Profile setup required</p>
              <% end %>
              <%= link_to "Settings (Coming Soon)", "#", class: "block w-full text-left px-4 py-2 text-sm text-slate-400 hover:bg-slate-800/50 rounded transition disabled opacity-60 cursor-not-allowed", disabled: true %>
            </div>

            <!-- Divider -->
            <div class="border-t border-slate-700/30"></div>

            <!-- Sign Out -->
            <div class="px-2 py-2">
              <%= button_to "Sign Out", destroy_user_session_path, method: :delete, class: "block w-full text-left px-4 py-2 text-sm text-rose-500 hover:bg-rose-500/10 rounded transition font-semibold bg-transparent border-0 cursor-pointer" %>
            </div>
          </div>
        </details>
      <% else %>
        <!-- Auth Links (when not signed in) -->
        <div class="flex items-center space-x-3">
          <%= link_to "Sign In", user_session_path, class: "px-4 py-2 text-purple-400 hover:text-purple-300 font-semibold transition" %>
          <%= link_to "Sign Up", new_user_registration_path, class: "px-4 py-2 bg-linear-to-r from-purple-600 to-pink-600 text-white rounded-lg hover:shadow-lg hover:shadow-purple-500/50 transition font-semibold" %>
        </div>
      <% end %>
    </div>
  </div>
</nav>

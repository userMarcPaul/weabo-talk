<% if @comment.parent_comment_id %>
  <%= turbo_stream.append "replies-#{@comment.parent_comment_id}", partial: "comments/comment", locals: { comment: @comment, post: @post } %>
<% else %>
  <%= turbo_stream.remove "no-comments-#{@post.id}" %>
  <%= turbo_stream.prepend "comments-#{@post.id}", partial: "comments/comment", locals: { comment: @comment, post: @post } %>
  <%= turbo_stream.replace "comment-form-#{@post.id}", partial: "comments/form", locals: { post: @post, comment: Comment.new } %>
<% end %>
